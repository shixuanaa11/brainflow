# ---- LLM 模型配置（默认 qwen，可切换）----
LLM_MODEL=qwen3.7-max
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- API 服务 ----
API_HOST=0.0.0.0
API_PORT=5173

# ---- LangSmith（可选，调试追踪）----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=brainflow
LANGSMITH_TRACING=false

# ---- Langfuse（可选，LLM 级可观测；本地 Docker 自托管 :3000，配置 key 后自动启用）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- 微信接入（留空 = 不启用，后续实现）----
WECHAT_ACP_PATH=
